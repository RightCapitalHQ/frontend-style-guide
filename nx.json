{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": {
          "targetName": "build",
          "configName": "tsconfig.src.json"
        },
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    }
  ],
  "sync": {
    "generatorOptions": {
      "@nx/js:typescript-sync": {
        "runtimeTsConfigFileNames": ["tsconfig.src.json"]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": [
        "{projectRoot}/lib",
        "{projectRoot}/tsconfig.src.tsbuildinfo"
      ],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "clean": {
      "cache": false
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/vitest.config.*"
    ],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json"]
  },
  "release": {
    "groups": {
      "eslint": {
        "projects": ["eslint-config", "eslint-plugin"],
        "projectsRelationship": "fixed"
      },
      "other": {
        "projects": ["prettier-config", "tsconfig", "lint-eslint-config-rules"],
        "projectsRelationship": "independent"
      }
    },
    "versionPlans": {
      "ignorePatternsForPlanCheck": [
        ".*ignore",
        ".yamllint",
        "prettier.config.*",
        "eslint.config.*",
        ".pnpm-store/**",
        ".vscode/**",
        "pnpm-lock.yaml"
      ]
    },
    "version": {
      "preVersionCommand": "pnpm run build"
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): applying package updates"
    },
    "changelog": {
      "projectChangelogs": {
        "renderer": "scripts/changelog-renderer.cjs",
        "createRelease": "github"
      },
      "workspaceChangelog": false
    },
    "releaseTag": {
      "pattern": "{projectName}_v{version}"
    }
  },
  "analytics": false
}
